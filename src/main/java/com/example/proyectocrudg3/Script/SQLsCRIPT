--creacion de base de datos
CREATE DATABASE bdventas

-- creacion de esquema general para base de datos
CREATE SCHEMA catalogo;

--creacion de tabla de marcas
CREATE TABLE catalogo.marcas
(
	id_marca SERIAL PRIMARY KEY,
	nombre VARCHAR(80) NOT NULL UNIQUE,
	pais_origen VARCHAR(80) NOT NULL,
	estado SMALLINT NOT NULL DEFAULT 1

	CONSTRAINT chk_marca_estado
		CHECK (estado in (0, 1))

);


--pruebas para validar los CONSTRAINTS
--Prueba 1 > no permite valores nulos
INSERT INTO catalogo.marcas(nombre , pais_origen, estado)
VALUES(NULL, 'Nicaragua', 1)

--Prueba 2 : no permite que la columna "nombre" tenga el mismo valor 2 veces
INSERT INTO catalogo.marcas(nombre , pais_origen, estado)
VALUES('almohada', 'Nicaragua', 1)

--Prueba 3 : agregar el registro por defecto de una fila en la columna de estado
INSERT INTO catalogo.marcas(nombre , pais_origen)
VALUES('Audifono', 'Nicaragua')


--Tabla 2 : Categorias
CREATE TABLE catalogo.categorias
(
	id_categoria SERIAL PRIMARY KEY,
	nombre VARCHAR(80) NOT NULL UNIQUE,
	descripcion VARCHAR(250),
	estado SMALLINT NOT NULL DEFAULT 1

	CONSTRAINT chk_categoria_estado
		CHECK (estado in (0, 1))
);

--Prueba 1 : validar que el nombre debe ser unico
INSERT INTO catalogo.categorias(nombre , descripcion)
VALUES('Sistema', 'Hay categoria de sistema')

--Prueba 2 : validar la descripcion de la categoria en NOT null y NULL
INSERT INTO catalogo.categorias(nombre)
VALUES('Robot')

-- Prueba 3 : agregar el registro por defecto de una fila en la columna de estado
INSERT INTO catalogo.categorias(nombre, descripcion)
VALUES('Electrodomestico', 'Sin estado' )


-------- Tabla 3 : Productos ----------------------
CREATE TABLE catalogo.productos
(
	id_producto SERIAL PRIMARY KEY,
	codigo VARCHAR(20) NOT NULL UNIQUE,
	nombre VARCHAR(120) NOT NULL UNIQUE,
	descripcion VARCHAR (200),
	precio NUMERIC(10, 2) NOT NULL,
	stock INTEGER NOT NULL DEFAULT 0,
	fecha_creacion DATE NOT NULL DEFAULT CURRENT_DATE,
	id_categoria INTEGER NOT NULL,
	id_marca INTEGER NOT NULL,
	estado SMALLINT NOT NULL DEFAULT 1,

	CONSTRAINT fk_producto_categoria
		FOREIGN KEY (id_categoria)
		REFERENCES catalogo.categorias(id_categoria),

	CONSTRAINT fk_producto_marca
		FOREIGN KEY (id_marca)
		REFERENCES catalogo.marcas(id_marca),

	CONSTRAINT chk_producto_precio
		CHECK (precio > 0),

	CONSTRAINT chk_producto_stock
		CHECK (stock >= 0),

	CONSTRAINT chk_producto_estado
		CHECK (estado in (0, 1))
);


