--consultas a revisar de la base de datos

--Consulta 1
SELECT *
FROM  catalogo.productos
WHERE precio BETWEEN 20 and 100;

SELECT *
FROM catalogo.productos
WHERE precio >= 20 AND precio <=100;

--Consulta 4
--Buscar los productos cuyos nombres contengan la palabra USB
SELECT *
FROM catalogo.productos
WHERE nombre ILIKE  '%son%';

--Consulta 5
--Buscar todos los productos cuyo codigo o nombre contenga el texto AU
SELECT *
FROM catalogo.productos
WHERE nombre ILIKE '%AU%' or codigo ILIKE '%AU%';
